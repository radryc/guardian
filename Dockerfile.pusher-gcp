FROM golang:1.26.10 AS build

ARG BUILD_VERSION=dev
ARG BUILD_COMMIT=unknown
ARG BUILD_TIME=unknown

WORKDIR /src/guardian

# Guardian's go.mod replaces github.com/radryc/monofs with ../monofs, and
# monofs/go.mod replaces github.com/radryc/kvs with ../kvs, so builds must
# provide both sibling repos as named build contexts.
COPY go.mod go.sum ./
COPY --from=monofs go.mod /src/monofs/go.mod
COPY --from=monofs go.sum /src/monofs/go.sum
COPY --from=kvs go.mod /src/kvs/go.mod
COPY --from=kvs go.sum /src/kvs/go.sum
RUN go mod download

# v1.0.1 fixes otelc pinning the pre-rename module path (see monofs/Dockerfile).
ARG OTELC_VERSION=v1.2.0
RUN GOBIN=/usr/local/bin go install go.opentelemetry.io/otelc/tool/cmd/otelc@${OTELC_VERSION}

COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
COPY --from=monofs . /src/monofs
COPY --from=kvs . /src/kvs

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS=-trimpath otelc go build \
  -ldflags "-s -w -X github.com/radryc/guardian/internal/buildinfo.Version=${BUILD_VERSION} -X github.com/radryc/guardian/internal/buildinfo.Commit=${BUILD_COMMIT} -X github.com/radryc/guardian/internal/buildinfo.BuildTime=${BUILD_TIME}" \
  -o /out/guardian-pusher-gcp ./cmd/guardian-pusher-gcp

FROM alpine:3.21

ARG BUILD_VERSION=dev
ARG BUILD_COMMIT=unknown
ARG BUILD_TIME=unknown
ARG TOFU_VERSION=1.9.1
# Optional: set to the sha256 of tofu_<version>_linux_amd64.zip in CI.
ARG TOFU_SHA256=""

RUN apk add --no-cache ca-certificates curl unzip yq && \
    curl -fsSL "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_amd64.zip" -o /tmp/tofu.zip && \
    if [ -n "$TOFU_SHA256" ]; then echo "${TOFU_SHA256}  /tmp/tofu.zip" | sha256sum -c -; fi && \
    unzip -o /tmp/tofu.zip -d /usr/local/bin tofu && \
    rm -f /tmp/tofu.zip && \
    chmod +x /usr/local/bin/tofu && \
    tofu version

RUN addgroup -S guardian && adduser -S -G guardian guardian && \
    mkdir -p /var/lib/guardian/pusher-gcp && chown -R guardian:guardian /var/lib/guardian

LABEL org.opencontainers.image.version=${BUILD_VERSION}
LABEL org.opencontainers.image.revision=${BUILD_COMMIT}
LABEL org.opencontainers.image.created=${BUILD_TIME}

COPY --from=build /out/guardian-pusher-gcp /usr/local/bin/guardian-pusher-gcp
COPY docker/pusher-gcp-entrypoint.sh /usr/local/bin/pusher-gcp-entrypoint

RUN chmod +x /usr/local/bin/pusher-gcp-entrypoint
USER guardian

ENTRYPOINT ["/usr/local/bin/pusher-gcp-entrypoint"]
