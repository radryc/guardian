FROM golang:1.26.10 AS build

WORKDIR /src/guardian

# Guardian's go.mod replaces github.com/radryc/monofs with ../monofs, and
# monofs/go.mod replaces github.com/radryc/kvs with ../kvs, so builds
# must provide both sibling repos as named build contexts.
COPY go.mod go.sum ./
COPY --from=monofs go.mod /src/monofs/go.mod
COPY --from=monofs go.sum /src/monofs/go.sum
COPY --from=kvs go.mod /src/kvs/go.mod
COPY --from=kvs go.sum /src/kvs/go.sum
RUN go mod download

# v1.0.1 fixes otelc pinning the pre-rename module path (see monofs/Dockerfile).
ARG OTELC_VERSION=v1.2.0
RUN GOBIN=/usr/local/bin go install go.opentelemetry.io/otelc/tool/cmd/otelc@${OTELC_VERSION}

COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
COPY --from=monofs . /src/monofs
COPY --from=kvs . /src/kvs

# Keep -trimpath in GOFLAGS so otelc's nested instrumented builds use the
# same flag set as the top-level build; passing -trimpath only on the command
# line triggers a linker "fingerprint mismatch" for otelc/pkg/runtime.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOFLAGS=-trimpath otelc go build -o /out/guardian-pusher-docker ./cmd/guardian-pusher-docker

FROM alpine:3.21

ARG BUILD_VERSION=dev
ARG BUILD_COMMIT=unknown
ARG BUILD_TIME=unknown

RUN apk add --no-cache ca-certificates docker-cli yq
RUN addgroup -S guardian && adduser -S -G guardian guardian && \
  mkdir -p /var/lib/guardian/pusher-docker && chown -R guardian:guardian /var/lib/guardian

LABEL org.opencontainers.image.version=${BUILD_VERSION}
LABEL org.opencontainers.image.revision=${BUILD_COMMIT}
LABEL org.opencontainers.image.created=${BUILD_TIME}

COPY --from=build /out/guardian-pusher-docker /usr/local/bin/guardian-pusher-docker
COPY docker/pusher-docker-entrypoint.sh /usr/local/bin/pusher-docker-entrypoint

RUN chmod +x /usr/local/bin/pusher-docker-entrypoint
USER guardian

ENTRYPOINT ["/usr/local/bin/pusher-docker-entrypoint"]
